{
  "$description": "One source for web (CSS custom properties) and SwiftUI (Tokens.swift). Values inferred from nirva.life computed styles on 2026-10-27; this is a starting point, not Nirva's system.",
  "color": {
    "mist": {
      "value": "#D4E2E8",
      "use": "Page and sheet background. Measured: body background on nirva.life."
    },
    "surface": {
      "value": "#EEF3F5",
      "use": "Opaque card surface where glass can't blur (SwiftUI fallback, print)."
    },
    "glass": {
      "value": "rgba(242,247,246,0.52)",
      "use": "Pill and card fill over mist. Measured: header pill."
    },
    "glassStrong": {
      "value": "rgba(221,232,235,0.77)",
      "use": "Pressed / selected pill. Measured: Join button."
    },
    "ink": {
      "value": "#343434",
      "use": "Primary text. 9.4:1 on mist."
    },
    "deep": {
      "value": "#303E41",
      "use": "Strong UI ink, icons, the arc line. 8.4:1 on mist."
    },
    "slate": {
      "value": "#627B82",
      "use": "Accent word in serif display text only (24pt+). 3.4:1 on mist, so never for body copy."
    },
    "slateInk": {
      "value": "#4F666C",
      "use": "Secondary text at any size. 4.6:1 on mist, 5.4:1 on surface."
    },
    "hairline": {
      "value": "rgba(48,62,65,0.14)",
      "use": "Dividers and card strokes."
    },
    "pause": {
      "value": "rgba(48,62,65,0.28)",
      "use": "Listening-paused gap in the day arc (dashed)."
    }
  },
  "space": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48
  },
  "radius": {
    "card": 22,
    "sheet": 28,
    "control": 14,
    "pill": 999
  },
  "type": {
    "display": {
      "family": "serif",
      "size": 26,
      "line": 33,
      "weight": 400,
      "swiftRelativeTo": "title"
    },
    "title": {
      "family": "serif",
      "size": 20,
      "line": 27,
      "weight": 400,
      "swiftRelativeTo": "title3"
    },
    "aside": {
      "family": "serifItalic",
      "size": 17,
      "line": 25,
      "weight": 400,
      "swiftRelativeTo": "body"
    },
    "body": {
      "family": "sans",
      "size": 16,
      "line": 24,
      "weight": 400,
      "swiftRelativeTo": "body"
    },
    "callout": {
      "family": "sans",
      "size": 15,
      "line": 21,
      "weight": 400,
      "swiftRelativeTo": "callout"
    },
    "caption": {
      "family": "sans",
      "size": 13,
      "line": 18,
      "weight": 400,
      "swiftRelativeTo": "footnote"
    },
    "button": {
      "family": "sans",
      "size": 15,
      "line": 20,
      "weight": 600,
      "swiftRelativeTo": "callout"
    },
    "label": {
      "family": "label",
      "size": 11,
      "line": 14,
      "weight": 700,
      "tracking": 0.08,
      "uppercase": true,
      "swiftRelativeTo": "caption2"
    },
    "code": {
      "family": "mono",
      "size": 11,
      "line": 17,
      "weight": 400,
      "swiftRelativeTo": "caption2"
    }
  },
  "family": {
    "serif": {
      "css": "var(--font-serif)",
      "swift": {
        "400": "LibreBaskerville-Regular"
      }
    },
    "serifItalic": {
      "css": "var(--font-serif)",
      "swift": {
        "400": "LibreBaskerville-Italic"
      },
      "italic": true
    },
    "sans": {
      "css": "var(--font-sans)",
      "swift": {
        "400": "NunitoSans12ptExtraLight12pt-Regular",
        "600": "NunitoSans12ptExtraLight12pt-SemiBold",
        "700": "NunitoSans12ptExtraLight12pt-Bold"
      }
    },
    "label": {
      "css": "var(--font-label)",
      "swift": {
        "700": "NunitoExtraLight-Bold"
      }
    },
    "$note": "Swift names are PostScript names of the bundled static instances (Google Fonts' latin subsets; the instancer names them oddly).",
    "mono": {
      "css": "var(--font-mono)",
      "swift": {
        "400": "Menlo-Regular"
      }
    }
  },
  "motion": {
    "settle": {
      "duration": 520,
      "bounce": 0.12,
      "use": "A block arriving: blur 6 to 0, rise 8pt, opacity 0 to 1."
    },
    "restream": {
      "duration": 380,
      "bounce": 0,
      "use": "A field replaced in place (dial, correction)."
    },
    "reduced": {
      "duration": 200,
      "use": "Reduce Motion: opacity crossfade only."
    }
  }
}