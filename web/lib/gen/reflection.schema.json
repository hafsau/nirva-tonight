{
  "$description": "Tonight's reflection, as the model returns it. Field order is generation order: a streamed snapshot fills fields top to bottom, so every block states its basis and confidence before it is allowed to say anything. The document's summary is generated last and displayed first.",
  "root": "Reflection",
  "types": {
    "Basis": {
      "doc": "One thing the reflection rests on. 'words' means a note derived from what she said; the words themselves were processed and discarded.",
      "fields": [
        [
          "signal",
          {
            "enum": [
              "pace",
              "pitch",
              "volume",
              "tone",
              "words",
              "calendar",
              "location",
              "checkIn",
              "correction"
            ]
          }
        ],
        [
          "at",
          {
            "optional": "string"
          },
          "Clock time, 24h, if the basis is a moment."
        ],
        [
          "note",
          "string",
          "Plain-language, relative to her own baseline."
        ]
      ]
    },
    "Delivery": {
      "doc": "How a claim is said. The dial changes only this.",
      "fields": [
        [
          "tone",
          {
            "enum": [
              "straight",
              "gentle",
              "pattern"
            ]
          }
        ],
        [
          "headline",
          "string"
        ],
        [
          "body",
          "string"
        ],
        [
          "step",
          {
            "optional": "string"
          },
          "At most one small, optional next step."
        ]
      ]
    },
    "ArcPoint": {
      "fields": [
        [
          "at",
          "string"
        ],
        [
          "level",
          "double",
          "Pace and pitch relative to her usual for this weekday, -1...1. Drawn, never printed."
        ]
      ]
    },
    "Span": {
      "fields": [
        [
          "from",
          "string"
        ],
        [
          "to",
          "string"
        ]
      ]
    },
    "Mark": {
