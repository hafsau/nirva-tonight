          "at",
          "string"
        ],
        [
          "label",
          "string"
        ]
      ]
    },
    "DayArc": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "basis",
          {
            "array": "Basis"
          }
        ],
        [
          "points",
          {
            "array": "ArcPoint"
          },
          ""
        ],
        [
          "paused",
          {
            "array": "Span"
          },
          "She paused listening (an assumed control; how pausing works on the device isn't public). Nothing was heard, so the arc shows a gap, not a guess."
        ],
        [
          "removed",
          {
            "array": "Span"
          },
          "Stretches she asked Nirva to forget or leave out. Also drawn as a gap."
        ],
        [
          "marks",
          {
            "array": "Mark"
          }
        ],
        [
          "caption",
          "string"
        ]
      ]
    },
    "Moment": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "basis",
          {
            "array": "Basis"
          }
        ],
        [
          "confidence",
          {
            "enum": [
              "clear",
              "tentative"
            ]
          }
        ],
        [
          "at",
          "string"
        ],
        [
          "headline",
          "string"
        ],
        [
          "body",
          "string"
        ]
